# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/suuui-win

# ============================================
# JWT SECRETS (CHANGE IN PRODUCTION!)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
ADMIN_JWT_SECRET=your-admin-secret-key-change-this-in-production-67890

# ============================================
# CORS & SECURITY
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com
ENABLE_HTTPS=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# ============================================
# PAYMENT GATEWAY INTEGRATION
# ============================================
PAYMENT_API_KEY=your_payment_gateway_api_key
PAYMENT_SECRET=your_payment_gateway_secret
PAYMENT_MODE=sandbox

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@suuuiwin.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=1800000

# ============================================
# CRYPTO CONFIGURATION (if using USDT/BTC/ETH)
# ============================================
CRYPTO_API_KEY=your_crypto_api_key
CRYPTO_NETWORK=mainnet
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETH_RPC_URL=https://mainnet.infura.io/v3/your-infura-key

# ============================================
# ADMIN PANEL SECRET
# ============================================
ADMIN_PANEL_SECRET=your-admin-panel-secret-key

# ============================================
# NOTIFICATION SETTINGS
# ============================================
ENABLE_SMS_NOTIFICATIONS=false
SMS_API_KEY=your_sms_api_key
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# GAME CONFIGURATION
# ============================================
MIN_BET_AMOUNT=10
MAX_BET_AMOUNT=100000
GAME_TIMER_DURATION=30

# ============================================
# WITHDRAWAL SETTINGS
# ============================================
DAILY_WITHDRAWAL_LIMIT=3
MIN_WITHDRAWAL_AMOUNT=100
MAX_WITHDRAWAL_AMOUNT=500000

# ============================================
# DEPOSIT SETTINGS
# ============================================
DEPOSIT_BONUS_PERCENTAGE=5
MIN_DEPOSIT_AMOUNT=10
MAX_DEPOSIT_AMOUNT=1000000

# ============================================
# WAGERING REQUIREMENTS
# ============================================
WAGERING_MULTIPLIER=1.0

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# MONITORING & ANALYTICS
# ============================================
ENABLE_ANALYTICS=true
ANALYTICS_API_KEY=your_analytics_key
SENTRY_DSN=https://your-sentry-dsn

# ============================================
# API KEYS FOR THIRD PARTY SERVICES
# ============================================
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
